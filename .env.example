# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé de service — jamais préfixée NEXT_PUBLIC_, jamais envoyée au navigateur.
# Utilisée uniquement dans src/lib/supabase/service.ts, côté serveur, pour les
# intégrations qui doivent contourner la RLS (assistant IA, sync Airtable, etc.
# — décision du 27/08/2026, section 12 du cadrage).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
